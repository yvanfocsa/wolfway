---
// src/components/AudienceSelector.astro
---

<section aria-labelledby="audience-selector-title" class="relative z-20 border-b border-slate-200/60 bg-white py-14 select-none sm:py-16">
  <div class="mx-auto max-w-7xl px-5 lg:px-10">
    <div class="mb-10 grid gap-4 md:grid-cols-[0.8fr_1fr] md:items-end">
      <h2 id="audience-selector-title" class="font-heading text-3xl font-extrabold uppercase leading-none text-ink sm:text-4xl">
        Start with what you need
      </h2>
      <p class="max-w-2xl text-base leading-relaxed text-slate-600 md:justify-self-end sm:text-lg">
        Freight coordination, carrier partnerships, and driver opportunities each have a direct path forward.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-0 divide-y divide-slate-200/80 md:grid-cols-3 md:divide-x md:divide-y-0">
      
      <!-- Panel 1: Shippers -->
      <a href="/request-a-quote" class="group flex flex-col justify-between pb-8 md:pb-0 md:px-8 md:first:pl-0 focus-visible:outline focus-visible:outline-3 focus-visible:outline-cyan/70 rounded-sm">
        <div>
          <h2 class="font-heading text-2xl font-extrabold uppercase text-ink leading-tight mb-2.5">
            Move your freight.
          </h2>
          <p class="mb-6 text-base leading-relaxed text-slate-600 font-body">
            Get a competitive freight quote for your next open-deck load.
          </p>
        </div>
        <span class="inline-flex min-h-11 items-center text-sm font-bold uppercase tracking-wider text-cyan-dark transition-colors group-hover:text-cyan font-body">
          REQUEST A QUOTE
          <svg class="ml-2 h-3.5 w-3.5 transition-transform duration-180 ease-out group-hover:translate-x-1.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>

      <!-- Panel 2: Carrier Partners -->
      <a href="/carrier" class="group flex flex-col justify-between py-8 md:py-0 md:px-8 focus-visible:outline focus-visible:outline-3 focus-visible:outline-cyan/70 rounded-sm">
        <div>
          <h2 class="font-heading text-2xl font-extrabold uppercase text-ink leading-tight mb-2.5">
            Keep your trucks moving.
          </h2>
          <p class="mb-6 text-base leading-relaxed text-slate-600 font-body">
            Apply to join the WolfWay Logistics LLC carrier network for steady loads.
          </p>
        </div>
        <span class="inline-flex min-h-11 items-center text-sm font-bold uppercase tracking-wider text-cyan-dark transition-colors group-hover:text-cyan font-body">
          BECOME A CARRIER
          <svg class="ml-2 h-3.5 w-3.5 transition-transform duration-180 ease-out group-hover:translate-x-1.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>

      <!-- Panel 3: Drivers -->
      <a href="/drive-with-us" class="group flex flex-col justify-between pt-8 md:pt-0 md:px-8 md:last:pr-0 focus-visible:outline focus-visible:outline-3 focus-visible:outline-cyan/70 rounded-sm">
        <div>
          <h2 class="font-heading text-2xl font-extrabold uppercase text-ink leading-tight mb-2.5">
            Drive with purpose.
          </h2>
          <p class="mb-6 text-base leading-relaxed text-slate-600 font-body">
            Review qualifications, equipment, support, and open-deck opportunities before applying.
          </p>
        </div>
        <span class="inline-flex min-h-11 items-center text-sm font-bold uppercase tracking-wider text-cyan-dark transition-colors group-hover:text-cyan font-body">
          EXPLORE OPPORTUNITIES
          <svg class="ml-2 h-3.5 w-3.5 transition-transform duration-180 ease-out group-hover:translate-x-1.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>

    </div>
  </div>
</section>
