---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Button from '@/components/Button.astro';
import { shipperFAQs, driverFAQs } from '@/content/faq';
---

<BaseLayout
  title="Frequently Asked Questions | WolfWay Logistics LLC"
  description="Find quick answers to common questions about freight shipping, open-deck equipment, driver qualification, rates, and 24/7 dispatch support."
>
  <PageHero
    title="Frequently Asked Questions"
    description="Clear answers about open-deck freight, equipment, driver opportunities, rates, and dispatch coordination."
    align="center"
    compact={true}
  />

  <!-- Interactive FAQ Section -->
  <section class="bg-offwhite py-16 sm:py-20 border-b border-slate-200/60 select-none">
    <div class="mx-auto max-w-5xl px-5 lg:px-10">
      
      <!-- Category Tabs -->
      <div class="flex justify-center mb-10">
        <div class="flex w-full max-w-sm gap-2 rounded-lg border border-slate-300/50 bg-slate-200/70 p-1.5" role="tablist" aria-label="FAQ category">
          <button
            id="tab-shippers"
            role="tab"
            aria-selected="true"
            aria-controls="faq-shippers-container"
            class="faq-tab min-h-11 min-w-0 flex-1 rounded-md px-3 py-2.5 font-heading text-sm font-bold uppercase tracking-wider text-slate-600 transition-[background-color,color,box-shadow] duration-200 outline-none hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-dark focus-visible:outline-offset-2 sm:px-6"
          >
            Shippers
          </button>
          <button
            id="tab-drivers"
            role="tab"
            aria-selected="false"
            aria-controls="faq-drivers-container"
            class="faq-tab min-h-11 min-w-0 flex-1 rounded-md px-3 py-2.5 font-heading text-sm font-bold uppercase tracking-wider text-slate-600 transition-[background-color,color,box-shadow] duration-200 outline-none hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-dark focus-visible:outline-offset-2 sm:px-6"
          >
            Drivers
          </button>
        </div>
      </div>

      <!-- Shippers FAQ Container -->
      <div id="faq-shippers-container" class="space-y-4" role="tabpanel" aria-labelledby="tab-shippers">
        {shipperFAQs.map((faq) => (
          <details class="group bg-white border border-slate-200/80 rounded-xl overflow-hidden transition-all duration-300 shadow-xs open:border-cyan/40">
            <summary class="flex min-h-14 items-center justify-between gap-4 p-5 cursor-pointer select-none font-heading text-lg font-bold uppercase leading-snug text-ink outline-none group-hover:text-cyan transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-dark focus-visible:outline-offset-[-2px] sm:p-6">
              <span class="min-w-0">{faq.question}</span>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 group-open:bg-cyan group-open:text-navy transition-colors">
                <svg class="h-4 w-4 transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 pt-2 text-slate-600 font-body text-base leading-relaxed border-t border-slate-100">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>

      <!-- Drivers FAQ Container (Hidden initially) -->
      <div id="faq-drivers-container" class="space-y-4 hidden" role="tabpanel" aria-labelledby="tab-drivers">
        {driverFAQs.map((faq) => (
          <details class="group bg-white border border-slate-200/80 rounded-xl overflow-hidden transition-all duration-300 shadow-xs open:border-cyan/40">
            <summary class="flex min-h-14 items-center justify-between gap-4 p-5 cursor-pointer select-none font-heading text-lg font-bold uppercase leading-snug text-ink outline-none group-hover:text-cyan transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-dark focus-visible:outline-offset-[-2px] sm:p-6">
              <span class="min-w-0">{faq.question}</span>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 group-open:bg-cyan group-open:text-navy transition-colors">
                <svg class="h-4 w-4 transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 pt-2 text-slate-600 font-body text-base leading-relaxed border-t border-slate-100">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>

      <!-- Help Card -->
      <div class="mt-14 rounded-lg border border-slate-200/80 bg-white p-6 text-center shadow-xs sm:p-8">
        <h2 id="faq-help-title" class="mb-2 font-heading text-xl font-bold uppercase text-ink">Still have a load question?</h2>
        <p id="faq-help-copy" class="mb-6 text-base text-slate-600 font-body">Talk directly with dispatch or send the shipment details for a focused freight quote.</p>
        <div class="flex flex-col justify-center gap-3 sm:flex-row sm:gap-4">
          <Button id="faq-primary-action" href="tel:+12244464256" variant="primary" size="md" class="w-full sm:w-auto">
            <span id="faq-primary-label">Call Dispatch</span>
          </Button>
          <Button id="faq-secondary-action" href="/request-a-quote#quote-form-section" variant="secondary" size="md" class="w-full sm:w-auto">
            <span id="faq-secondary-label">Request Freight Quote</span>
          </Button>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .faq-tab[aria-selected='true'] {
    background: #ffffff;
    color: #131722;
    box-shadow: 0 1px 2px rgb(15 23 42 / 8%);
  }
</style>

<script>
  function setupFAQTabs() {
    const tabShippers = document.getElementById('tab-shippers');
    const tabDrivers = document.getElementById('tab-drivers');
    const containerShippers = document.getElementById('faq-shippers-container');
    const containerDrivers = document.getElementById('faq-drivers-container');
    const helpTitle = document.getElementById('faq-help-title');
    const helpCopy = document.getElementById('faq-help-copy');
    const primaryAction = document.getElementById('faq-primary-action') as HTMLAnchorElement | null;
    const primaryLabel = document.getElementById('faq-primary-label');
    const secondaryAction = document.getElementById('faq-secondary-action') as HTMLAnchorElement | null;
    const secondaryLabel = document.getElementById('faq-secondary-label');

    if (!tabShippers || !tabDrivers || !containerShippers || !containerDrivers) return;
    if (tabShippers.dataset.faqTabsBound === 'true') return;

    const shipperTab = tabShippers;
    const driverTab = tabDrivers;
    const shipperPanel = containerShippers;
    const driverPanel = containerDrivers;

    shipperTab.dataset.faqTabsBound = 'true';
    driverTab.dataset.faqTabsBound = 'true';

    function showAudience(audience: 'shippers' | 'drivers') {
      const isShipper = audience === 'shippers';

      shipperTab.setAttribute('aria-selected', String(isShipper));
      driverTab.setAttribute('aria-selected', String(!isShipper));
      shipperTab.setAttribute('tabindex', isShipper ? '0' : '-1');
      driverTab.setAttribute('tabindex', isShipper ? '-1' : '0');
      shipperPanel.classList.toggle('hidden', !isShipper);
      driverPanel.classList.toggle('hidden', isShipper);
      shipperPanel.setAttribute('aria-hidden', String(!isShipper));
      driverPanel.setAttribute('aria-hidden', String(isShipper));

      if (helpTitle) helpTitle.textContent = isShipper ? 'Still have a load question?' : 'Ready for the next step?';
      if (helpCopy) {
        helpCopy.textContent = isShipper
          ? 'Talk directly with dispatch or send the shipment details for a focused freight quote.'
          : 'Start the short pre-qualification or speak directly with recruiting before you apply.';
      }
      if (primaryAction) primaryAction.href = isShipper ? 'tel:+12244464256' : '/driver-application#pre-qualify-form';
      if (primaryLabel) primaryLabel.textContent = isShipper ? 'Call Dispatch' : 'Start Driver Application';
      if (secondaryAction) secondaryAction.href = isShipper ? '/request-a-quote#quote-form-section' : 'tel:+12244464256';
      if (secondaryLabel) secondaryLabel.textContent = isShipper ? 'Request Freight Quote' : 'Call Recruiting';
    }

    shipperTab.addEventListener('click', () => showAudience('shippers'));
    driverTab.addEventListener('click', () => showAudience('drivers'));

    const tabs = [shipperTab, driverTab];
    tabs.forEach((tab, index) => {
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const nextIndex = event.key === 'ArrowRight' ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
        const nextTab = tabs[nextIndex];
        nextTab?.focus();
        showAudience(nextTab === driverTab ? 'drivers' : 'shippers');
      });
    });

    const requestedAudience = new URLSearchParams(window.location.search).get('audience');
    showAudience(requestedAudience === 'drivers' ? 'drivers' : 'shippers');
  }

  setupFAQTabs();
  document.addEventListener('astro:page-load', setupFAQTabs);
</script>
